# --- Oscilion ---
# Data and artifacts (never in the repo). ANCHORED to the root with "/" so source
# packages such as oscilion/data/ are NOT ignored (earlier bug: "data/" hid them).
/data/
/logs/
*.db
*.db-wal
*.db-shm
*.parquet

# Secrets / environment
.env
*.env
!example.env

# Python (build dirs anchored to the root so they do not clash with frontend/dist)
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
/build/
/dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Frontend
frontend/node_modules/
# frontend/dist IS versioned: the VM serves the build without needing Node.

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
