# Oscilion environment template.
# On the VM: copy to /etc/oscilion.env (root:root, chmod 600).
# Never commit the real .env.
# Every variable below is optional; the value shown is the default in config.py
# unless noted otherwise.

# ---------------------------------------------------------------- mode
# dry-run (safe, never trades) | paper | live
OSCILION_MODE=dry-run
OSCILION_VERSION=0.6.0-pilot

# ------------------------------------------------------ universe / data
# Comma-separated. Empty = the core defined in oscilion/strategies/assignment.py.
# OSCILION_SYMBOLS=BTC/USDT:USDT,BNB/USDT:USDT,TRX/USDT:USDT,LINK/USDT:USDT,DOT/USDT:USDT
OSCILION_BASE_TF=1h
OSCILION_FAST_TF=15m
OSCILION_EXCHANGE=binanceusdm
# OSCILION_DATA_DIR=./data
# OSCILION_LOGS_DIR=./logs
# OSCILION_DB_PATH=./data/oscilion.db

# ---------------------------------------------------------------- loop
# Live, 5 minutes is enough: signals are on 1h/4h candles. (config.py default: 60)
OSCILION_TICK_SECONDS=300
OSCILION_CCXT_TIMEOUT_MS=10000

# ----------------------------------- risk (INVARIANTS, see docs/RISK_MODEL.md)
OSCILION_RISK_PER_TRADE=0.02
OSCILION_MIN_PROFIT=0.05
OSCILION_MIN_RR=2.5
OSCILION_TAKER_FEE=0.00036
OSCILION_MAX_CONCURRENT=3
OSCILION_MIN_STOP_PCT=0.002
OSCILION_MAX_COST_R=0.12

# ------------------------------------------------------ market regime gate
OSCILION_MKT_REGIME=true
OSCILION_MKT_BENCH=BTC/USDT:USDT
OSCILION_MKT_TF_H=4
OSCILION_MKT_EMA=50
OSCILION_REGIME_EXEMPT=break_retest
OSCILION_REGIME_EXEMPT_SYMS=PAXG/USDT:USDT,XAU/USDT:USDT

# --------------------------------------------------------- validation gate
OSCILION_GATE_MIN_N=30
OSCILION_GATE_MIN_EXP_R=0.05
OSCILION_GATE_BT_FROM_MS=1735689600000
OSCILION_GATE_FW_KILL_N=15
OSCILION_GATE_FW_KILL_EXP_R=-0.10
OSCILION_GATE_FW_GRAD_N=20
OSCILION_GATE_FW_GRAD_EXP_R=0.10
OSCILION_GATE_REAL_FW_FROM_MS=1782776880000
OSCILION_GATE_ROBUST=true
OSCILION_GATE_ROBUST_MIN_N=20
OSCILION_GATE_ROBUST_SPLIT_MS=1767225600000
OSCILION_MAX_SIGNAL_AGE_MIN=30

# --------------------------------------------------------- circuit breaker
OSCILION_MAX_DAILY_LOSS=0.06
OSCILION_MAX_ERRORS=10

# ---------------------------------------------------- forward validation
# Start of the "unseen" period, epoch ms. setup_vm.sh sets it to the deployment
# date. Manually: `date +%s` * 1000.
# OSCILION_FORWARD_INCEPTION_MS=

# ------------------------------------------------------------- alerts
# ntfy.sh push alerts. The topic name acts as a password: anyone who knows it can
# read and publish, so use a long random string. Empty = disabled.
OSCILION_NTFY_TOPIC=
# Telegram (optional). Empty = disabled.
OSCILION_TG_TOKEN=
OSCILION_TG_CHAT=

# --------------------------------------------------------- API / dashboard
# 127.0.0.1 = local only (reach it through an SSH tunnel). 0.0.0.0 exposes the
# read-only dashboard publicly and needs the port opened in the firewall.
OSCILION_API_HOST=127.0.0.1
OSCILION_API_PORT=8787

OSCILION_LOG_LEVEL=INFO

# setup_vm.sh only: repository to clone.
# OSCILION_REPO=https://github.com/<user>/<repo>.git
